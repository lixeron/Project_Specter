# ──────────────────────────────────────────────
# Specter — Environment Configuration
# Copy to .env and fill in values
# ──────────────────────────────────────────────

# ── App ──────────────────────────────────────
APP_NAME=specter
APP_ENV=development                   # development | staging | production
DEBUG=true
SECRET_KEY=change-me-to-a-random-string-at-least-32-chars
API_HOST=0.0.0.0
API_PORT=8000

# ── Database ─────────────────────────────────
# PostgreSQL (production):
# DATABASE_URL=postgresql+asyncpg://specter:password@localhost:5432/specter
# SQLite (local dev):
DATABASE_URL=sqlite+aiosqlite:///./specter.db

# ── Redis ────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Auth ─────────────────────────────────────
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── LLM (Phase 2) ───────────────────────────
# LLM_PROVIDER=openai                 # openai | anthropic | ollama | mock
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# OLLAMA_BASE_URL=http://localhost:11434

# ── Email (Phase 2) ─────────────────────────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=
# SMTP_USE_TLS=true

# ── SMS (Phase 4, Pro) ──────────────────────
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# ── Tracking ─────────────────────────────────
# BASE_URL=https://your-specter-domain.com   # Used for tracking links
BASE_URL=http://localhost:8000
